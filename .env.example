# The values of a deploy of ClaimDepositFactory (script/Deploy.s.sol). Names only, no values.
# THKR on Robinhood Chain.
TOKEN=
# Where the THKR of a claim that went through goes.
BURN_ADDRESS=
# The most THKR that one claim burns, in the smallest unit (18 decimals).
BURN_AMOUNT=
# May name another operator, or another owner.
OWNER=
# The address of the key of the issuer, which settles and refunds the claims.
OPERATOR=
